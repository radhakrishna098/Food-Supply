# ========================================================
# FoodLoop Backend Environment Variables
# ========================================================

# Host Port (Render automatically sets PORT in production)
PORT=5000

# Node Environment ('development', 'production', or 'test')
NODE_ENV=development

# MongoDB Connection String
# Local Development: mongodb://127.0.0.1:27017/foodloop
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/foodloop?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/foodloop

# JWT Secret - Must be a strong, randomly generated string of at least 32 characters in production.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=foodloop_dev_jwt_secret_key_random_long_token_2024_secure

# Token lifespan (e.g., '7d', '24h')
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS)
# Supports exact single URL or comma-separated list of origins.
# Development: http://localhost:5173
# Production: https://your-frontend-service.onrender.com
FRONTEND_URL=http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
