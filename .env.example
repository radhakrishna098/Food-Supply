# ==============================================================================
# FoodLoop - Environment Variable Reference
# ==============================================================================
#
# NOTE: FoodLoop consists of two distinct services when deployed to Render:
# 1. Backend Web Service (Node.js/Express)
# 2. Frontend Static Site (Vite/React)
#
# Configure the respective variables in each service's Render Environment Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE ENVIRONMENT VARIABLES (Render Web Service)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
# MongoDB Atlas Connection String:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/foodloop?retryWrites=true&w=majority
# Strong production JWT Secret (min 32 chars):
JWT_SECRET=replace_with_crypto_generated_random_secret_minimum_32_characters
JWT_EXPIRES_IN=7d
# Deployed frontend URL (without trailing slash):
FRONTEND_URL=https://foodloop-frontend.onrender.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ------------------------------------------------------------------------------
# 2. FRONTEND STATIC SITE ENVIRONMENT VARIABLES (Render Static Site Build)
# ------------------------------------------------------------------------------
# Deployed backend API URL (with '/api' path, e.g. https://foodloop-backend.onrender.com/api):
VITE_API_BASE_URL=https://foodloop-backend.onrender.com/api
