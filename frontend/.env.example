# ========================================================
# FoodLoop Frontend Environment Variables
# ========================================================

# Base URL for backend API requests in production.
# Omit or leave empty in local development to utilize Vite's dev server proxy (/api -> http://localhost:5000).
# In production on Render Static Site, set this to your Render backend web service URL:
# Example: https://foodloop-backend.onrender.com/api
VITE_API_BASE_URL=
